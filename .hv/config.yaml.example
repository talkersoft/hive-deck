# Per-machine setup. Copy to setup.yaml (gitignored) and edit for your machine.
# Defines where to provision, how to talk to git hosts, and any branch overrides.

decks_root: ~/hive   # base folder where each deck folder is created

orgs:                          # one entry per GitHub org you clone from
  <org-key>:                   # short name referenced by `org:` in your manifests
    url: github.com/<your-github-org>
    protocol: https            # ssh | https
  # personal:                  # example: your personal GitHub username
  #   url: github.com/<your-github-username>
  #   protocol: https
  # <another-org-key>:
  #   url: github.com/<another-github-org>
  #   protocol: ssh

# Default branch applied to every cloned repo unless overridden below.
default_branch: main

# Per-repo branch overrides — only list repos that differ from default_branch.
branches: {}
  # <repo-name>: <branch-name>

# Optional: write a .gitignore at each workspace and system directory.
# Applied idempotently — existing lines are never duplicated.
# Defaults: .claude/, *.md, !README.md (used when entries is omitted or empty).
gitignore:
  entries:
    - .claude/
    - "*.md"
    - "!README.md"

# Optional: create a minimal README.md in each workspace and system directory.
# Existing README.md files are never overwritten.
readme:
  enabled: false

# Optional: ship behaviour.
ship:
  # After opening PRs, automatically delete the feature branch from GitHub on merge.
  delete_branch_on_merge: false

  # When true, block hv next and hv teardown if any repo has an open (unmerged) PR.
  # Creates a human review gate — the workspace stays on the feature branch until all
  # PRs are merged.  Default: false (open PRs are fine, transition proceeds immediately).
  require_merged_pr: false

  # When true, automatically merge every PR immediately after opening via gh pr merge.
  # Pairs with require_merged_pr: true to get an instant, gated ship-and-transition flow.
  # Default: false.
  auto_merge: false

  # When true (and auto_merge is on), tear down every repo from disk after PRs are merged.
  # Use this for ephemeral/CI flows where you want a clean slate between tasks.
  # Default: false (deck stays on disk; use hv next to transition to the next branch).
  teardown_on_ship: false

# Optional: drop a .claude/settings.local.json into every cloned repo so Claude
# Code picks up project-local permissions without per-repo setup. Existing
# files are never overwritten — hv only writes when the file is absent.
claude_settings:
  enabled: false               # flip to true to enable per-repo provisioning
  allow:                       # permission patterns merged into permissions.allow (existing entries preserved)
    - "*"
    - "Bash(*)"
    - "Edit(*)"
    - "Write(*)"
    - "Read(*)"
    - "Glob(*)"
    - "Grep(*)"
    - "WebFetch(*)"
    - "WebSearch(*)"
  default_mode: bypassPermissions    # optional; "bypassPermissions" if omitted

# Optional: write MCP server config to {decks_root}/.claude/settings.json at init time.
# MCP definitions live in mcps.yaml (same search order as this file).
# Each deck declares which MCPs it needs via a top-level `mcps:` list.
mcp_manager:
  enabled: false   # flip to true to enable MCP config writing on hv init
